# Copy ONCE on a fresh clone, then fill YOUR landscape values. Never commit .env.
#   cp .env.example .env
# Then: ./scripts/configure.sh --from-env
#
# Do NOT re-run `cp .env.example .env` after you have filled .env — that wipes your IDs.
# These IDs/names are different for every Global Account / user.

# --- Global Account / Terraform provider ---
GLOBALACCOUNT_SUBDOMAIN=YOURGLOBALIDtrial-ga
CLI_SERVER_URL=https://cli.btp.cloud.sap
REGION=us10

SOURCE_SUBACCOUNT_ID=00000000-0000-0000-0000-000000000000

RECOVERY_SUBACCOUNT_NAME=is-recovery
RECOVERY_SUBACCOUNT_SUBDOMAIN=is-recovery-unique-123
CF_ORG_NAME=is-recovery-org
CF_SPACE_NAME=DEV
ADMIN_USER_EMAIL=you@example.com

# Entitlement service_name ≠ subscription app_name on many trials.
# Discover with:
#   btp list accounts/entitlement --subaccount <SOURCE_SUBACCOUNT_ID>
#   btp list accounts/subscription --subaccount <SOURCE_SUBACCOUNT_ID>
# Example trial: entitlement integrationsuite-trial, subscription it-cpitrial06-prov
INTEGRATION_SUITE_ENTITLEMENT_SERVICE_NAME=integrationsuite-trial
INTEGRATION_SUITE_SUBSCRIPTION_APP_NAME=it-cpitrial06-prov
INTEGRATION_SUITE_PLAN_NAME=trial
CF_RUNTIME_AMOUNT=4
CF_ENVIRONMENT_PLAN_NAME=trial
CREATE_INTEGRATION_SUITE_SUBSCRIPTION=true

USE_BTPCLI_SESSION=true
BTP_USERNAME=
BTP_PASSWORD=
